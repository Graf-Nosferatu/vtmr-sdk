{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Codex: all scripts",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/buildCodexAll.ps1"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Build Codex: list",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/buildCodexList.ps1"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Build Eng",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Sdk.csproj",
				"-c",
				"Debug_Eng"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build Rus",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/Sdk.csproj",
				"-c",
				"Debug_Rus"
			],
			"problemMatcher": "$msCompile"
		}
	]
}
